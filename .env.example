# Bundled free-tier AI key (server-side only, never exposed to the browser).
# Users without their own key fall back to this one.
AI_API_KEY=your-gemini-free-tier-key

# Provider for the bundled key: openai | anthropic | google (default: google).
AI_PROVIDER=google

# Optional model override (e.g. gemini-2.5-flash). Defaults to the provider default.
AI_MODEL=
