# Bundled free-tier AI key (server-side only, never exposed to the browser).
# Users without their own key fall back to this one.
AI_API_KEY=your-gemini-free-tier-key

# Provider for the bundled key: openai | anthropic | google (default: google).
AI_PROVIDER=google

# Optional model override (e.g. gemini-2.5-flash). Defaults to the provider default.
AI_MODEL=

# Reject AI API requests whose Origin header does not match the site origin
# (throttle-only protection; requests without an Origin header still pass).
# Set to false to disable. Default: true.
AI_ENFORCE_ORIGIN=true

# Optional extra origins allowed through the origin gate (comma-separated),
# e.g. when the PWA is served from a different host than the API.
# AI_ALLOWED_ORIGINS=https://app.example.com,https://cv.example.com
