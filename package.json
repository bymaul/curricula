{
  "name": "curricula",
  "version": "1.0.0",
  "packageManager": "pnpm@11.14.0",
  "description": "An offline-first PWA resume builder featuring immaculate classic Harvard table-layout typography for clean print and PDF layouts.",
  "private": true,
  "keywords": [
    "nextjs",
    "react",
    "pwa",
    "resume-builder",
    "cv-builder",
    "harvard-template",
    "offline-first"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "ai": "^7.0.93",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-to-print": "^3.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
